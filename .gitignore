# Rust / Tauri build output (matches any depth, e.g. src-tauri/target, crates/*/target)
target/

# Bun / frontend
node_modules/
dist/
dist-ssr/
*.local

# Generic build/package output
bin/
build/

# Logs
logs
*.log

# Real combat log test fixtures (100s of MB, not meant for git) -- small
# synthetic fixtures we build later are fine to commit under this same dir,
# just don't share this filename pattern.
src-tauri/tests/fixtures/WoWCombatLog-*.txt

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# OS
.DS_Store
